# Segredos de bootstrap da API. Fornecedores e chaves de cliente são gerenciados no painel.
ANUBIS_ADMIN_KEY=crie_uma_chave_longa_e_aleatoria_para_o_painel
ANUBIS_ENCRYPTION_KEY=gere_uma_chave_hexadecimal_de_64_caracteres
PORT=3210
# HOST=127.0.0.1

# Produção: origens aceitas pelo painel e banco Postgres. Sem DATABASE_URL, os dados ficam em data/.
# ANUBIS_PUBLIC_URL=https://anubisrouter.com,https://admin.anubisrouter.com
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Durante a transição, aponta para a raiz do monorepo para servir o site em ../public.
# O VSIX da extensão fica em api/extension/ e não depende desta variável.
# ANUBIS_WEB_ROOT=..

# npm run dev com o banco do Coolify (sem porta pública), via túnel SSH:
# TUNNEL_SSH_HOST=45.154.159.48
# TUNNEL_SSH_PORT=22
# TUNNEL_SSH_USER=root
# TUNNEL_SSH_PASS=

# Contas de cliente: links de confirmação e de acesso apontam para o site.
# ANUBIS_SITE_URL=https://anubisrouter.com
# E-mail por SMTP. Sem SMTP_HOST, o link aparece só no log (uso local).
# SMTP_HOST=mail.seudominio.com
# SMTP_PORT=587            # 587 = STARTTLS; 465 = TLS direto
# SMTP_SECURE=false        # true quando a porta for 465
# SMTP_USER=no-reply@anubisrouter.com
# SMTP_PASS=
# MAIL_FROM=Anubis Router <no-reply@anubisrouter.com>

# Playground sem conta: modelos grátis, mensagens por visitante (IP) em 24h e teto diário geral.
# PLAYGROUND_MODELS=anubis/gpt-5-codex:free,anubis/deepseek-v4.1-flash:free,anubis/qwen3.8-flash:free,anubis/mimo-v2.5:free
# PLAYGROUND_FREE_MESSAGES=10
# PLAYGROUND_DAILY_CAP=3000

# Pagamento das recargas. PAYMENT_GATEWAYS liga e ordena os gateways (sem ela, ligam todos os configurados).
# PAYMENT_GATEWAYS=coinbase,payssion
# Coinbase Business (USDC): chave CDP só com permissão "View", algoritmo Ed25519; o segredo do webhook vem ao criar a assinatura.
# COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
# COINBASE_API_KEY_SECRET=
# COINBASE_WEBHOOK_SECRET=
# Payssion (PIX, boleto, cartão)
# PAYSSION_API_KEY=
# PAYSSION_SECRET_KEY=
# PAYSSION_SANDBOX=true
